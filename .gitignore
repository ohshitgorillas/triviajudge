.venv/
__pycache__/
*.egg-info/
build/
dist/
.pytest_cache/

# The clean-line cache is per-checkout state, not a fact about the code.
.triviajudge/
.coverage
.coverage.json
.ruff_cache/
.mypy_cache/

# The junit report a run writes, and the wall time of the last green run the
# suite-time gate compares against. Both are per-checkout measurements.
.pytest-junit.xml
.suite-time.json

# jscpd and nothing else. package-lock.json is tracked, the tree it installs is not.
node_modules/

# The working copies `make mutate` writes, rebuilt from scratch every run.
mutants/
